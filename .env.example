# ===== 文章生成 AI Provider =====
# 显式指定用哪个 provider：ark | minimax
# 不设置时自动探测：配置了方舟 Key 就用方舟 Coding Plan，否则用 Minimax
# AI_PROVIDER=ark

# --- 火山引擎方舟 Coding Plan（推荐，OpenAI 兼容） ---
# 控制台「Coding Plan」页面获取的 API Key
ARK_PLAN_API_KEY=your_ark_plan_api_key
# 默认：https://ark.cn-beijing.volces.com/api/coding/v3
# ARK_API_BASE=https://ark.cn-beijing.volces.com/api/coding/v3
# 默认：deepseek-v4-1-flash-260910（可选 deepseek-v4-pro-ga-260813）
# ARK_MODEL=deepseek-v4-1-flash-260910

# --- Minimax（OpenAI 兼容） ---
# MINIMAX_API_KEY=your_minimax_api_key
# MINIMAX_API_BASE=https://api.minimaxi.com/v1
# MINIMAX_MODEL=MiniMax-M2.7

# ===== Whisper 本地转录 =====
WHISPER_MODEL_PATH=whisper.cpp/models/ggml-large-v3.bin
WHISPER_USE_CUDA=1

# ===== 数据库 =====
DATABASE_URL="file:./dev.db"
